diff --git a/td/telegram/files/FileLoaderUtils.cpp b/td/telegram/files/FileLoaderUtils.cpp
index 02aa5e4c4..9def75551 100644
--- a/td/telegram/files/FileLoaderUtils.cpp
+++ b/td/telegram/files/FileLoaderUtils.cpp
@@ -23,0 +24 @@
+#include <atomic>
@@ -31,0 +33,20 @@ namespace {
+std::atomic<int32> mithka_download_chunk_size{0};
+std::atomic<int32> mithka_download_parallelism{0};
+std::atomic<int32> mithka_upload_chunk_size{0};
+std::atomic<int32> mithka_upload_parallelism{0};
+
+int32 normalize_mithka_part_size(int32 part_size, int32 max_part_size) {
+  if (part_size <= 0) {
+    return 0;
+  }
+  int32 result = 4 << 10;
+  while (result < max_part_size && result <= part_size / 2) {
+    result *= 2;
+  }
+  return result;
+}
+
+int32 normalize_mithka_parallelism(int32 parallelism) {
+  return parallelism <= 0 ? 0 : td::min(parallelism, 24);
+}
+
@@ -84,0 +106,26 @@ StringBuilder &operator<<(StringBuilder &sb, const Ext &ext) {
+void set_mithka_transfer_boost(int32 download_chunk_size, int32 download_parallelism, int32 upload_chunk_size,
+                               int32 upload_parallelism) {
+  mithka_download_chunk_size.store(normalize_mithka_part_size(download_chunk_size, 1 << 20),
+                                   std::memory_order_relaxed);
+  mithka_download_parallelism.store(normalize_mithka_parallelism(download_parallelism), std::memory_order_relaxed);
+  mithka_upload_chunk_size.store(normalize_mithka_part_size(upload_chunk_size, 512 << 10),
+                                 std::memory_order_relaxed);
+  mithka_upload_parallelism.store(normalize_mithka_parallelism(upload_parallelism), std::memory_order_relaxed);
+}
+
+int32 get_mithka_download_chunk_size() {
+  return mithka_download_chunk_size.load(std::memory_order_relaxed);
+}
+
+int32 get_mithka_download_parallelism() {
+  return mithka_download_parallelism.load(std::memory_order_relaxed);
+}
+
+int32 get_mithka_upload_chunk_size() {
+  return mithka_upload_chunk_size.load(std::memory_order_relaxed);
+}
+
+int32 get_mithka_upload_parallelism() {
+  return mithka_upload_parallelism.load(std::memory_order_relaxed);
+}
+
